# ── .dockerignore ─────────────────────────────────────────────────────────────
# Exclude files that should NOT be copied into the Docker image

# Git
.git
.gitignore
.gitattributes

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv
venv
env
ENV

# Environment files (secrets — use Docker --env-file or HF Spaces Secrets instead)
.env
.env.*
*.env

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Testing
.pytest_cache
htmlcov
.coverage
*.log

# Notebooks (not needed in production)
*.ipynb
.ipynb_checkpoints

# OS files
.DS_Store
Thumbs.db

# Node (if any)
node_modules

# Docs
README.md
docs/
