# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git.
#
# Usage:
#   cp .env.example .env
#   # Fill in your values, then:
#   docker run --env-file .env ...

# ── Groq API (LLM) ────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Pinecone (Vector Store) ───────────────────────────────────────────────────
# Get from: https://www.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=airline-faq-index

# ── Supabase PostgreSQL (Flight Database) ─────────────────────────────────────
# Get from: Supabase Dashboard → Connect → Session Pooler
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password

# ── Application Settings ──────────────────────────────────────────────────────
# Internal API URL (Streamlit → FastAPI, same container)
API_URL=http://localhost:8000

# Path to the knowledge base PDF inside the container
PDF_PATH=data/Knowledge_Base_for_Airline_Info_and_FAQs.pdf
